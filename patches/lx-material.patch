+// Keep original indices available to menus; filtering never reorders stored lists.
+export const filterPlaylists = (lists: LX.List.MyListInfo[], keyword: string, excludeId?: string) => {
+  const query = keyword.trim().toLocaleLowerCase()
+  const matches = lists.filter(list => list.id !== excludeId && list.name.toLocaleLowerCase().includes(query))
+  return [...matches.filter(list => list.id === LIST_IDS.LOVE), ...matches.filter(list => list.id !== LIST_IDS.LOVE)]
+}
