diff --git a/src/core/favorites.ts b/src/core/favorites.ts
new file mode 100644
index 0000000..1a9f9c6
--- /dev/null
+++ b/src/core/favorites.ts
@@ -0,0 +1,22 @@
+import { addListMusics, getListMusics, removeListMusics } from '@/core/list'
+import { LIST_IDS } from '@/config/constant'
+import settingState from '@/store/setting/state'
+
+const pending = new Map<string, Promise<boolean>>()
+
+// Multiple visible copies of the same song share one write while it is pending.
+export const toggleFavorite = (music: LX.Music.MusicInfo): Promise<boolean> => {
+  const previous = pending.get(music.id)
+  if (previous) return previous
+  const operation = (async() => {
+    const list = await getListMusics(LIST_IDS.LOVE)
+    const exists = list.some(item => item.id === music.id)
+    if (exists) await removeListMusics(LIST_IDS.LOVE, [music.id])
+    else await addListMusics(LIST_IDS.LOVE, [music], settingState.setting['list.addMusicLocationType'])
+    return !exists
+  })()
+  pending.set(music.id, operation)
+  const cleanup = () => { if (pending.get(music.id) === operation) pending.delete(music.id) }
+  void operation.then(cleanup, cleanup)
+  return operation
+}
