+export const useListMusicCount = (listId: string) => {
+  const [count, setCount] = useState<number | null>(null)
+  useEffect(() => {
+    let disposed = false
+    let revision = 0
+    const refresh = () => {
+      const request = ++revision
+      void getListMusics(listId).then(list => {
+        if (!disposed && request === revision) setCount(list.length)
+      }).catch(() => {
+        if (!disposed && request === revision) setCount(null)
+      })
+    }
+    const handleUpdate = (ids: string[]) => { if (ids.includes(listId)) refresh() }
+    setCount(null)
+    global.app_event.on('myListMusicUpdate', handleUpdate)
+    refresh()
+    return () => {
+      disposed = true
+      global.app_event.off('myListMusicUpdate', handleUpdate)
+    }
+  }, [listId])
+  return count
+}
