@@ -0,0 +1,84 @@
+import { useState } from 'react'
+import { FlatList, View } from 'react-native'
+import Input from '@/components/common/Input'
+import Button from '@/components/common/Button'
+import Text from '@/components/common/Text'
+import { Icon } from '@/components/common/Icon'
+import CreateUserList from '@/components/MusicAddModal/CreateUserList'
+import { useMyList, useMusicExistsList } from '@/store/list/hook'
+import { useTheme } from '@/store/theme/hook'
+import { useI18n } from '@/lang'
+import { getMaterialColors } from '@/theme/material'
+import { filterPlaylists } from '@/utils/playlist'
+import { LIST_IDS } from '@/config/constant'
+import { createStyle } from '@/utils/tools'
+
+const PlaylistRow = ({ list, musicInfo, onPress, disabled }: {
+  list: LX.List.MyListInfo
+  musicInfo?: LX.Music.MusicInfo
+  onPress: (list: LX.List.MyListInfo) => void
+  disabled: boolean
+}) => {
+  const colors = getMaterialColors(useTheme())
+  const t = useI18n()
+  return (
+    <Button style={{ ...styles.row, backgroundColor: colors.surfaceContainer }} onPress={() => { onPress(list) }} disabled={disabled} accessibilityRole="button" accessibilityLabel={list.name + (disabled ? ' · ' + t('library_saved') : '')}>
+      <Icon name={list.id === LIST_IDS.LOVE ? 'love' : 'album'} color={colors.primary} size={22} />
+      <Text style={{ flex: 1, marginLeft: 16 }} numberOfLines={1}>{list.name}</Text>
+      {disabled && musicInfo ? <Text color={colors.onSurfaceVariant} size={12}>{t('library_saved')}</Text> : <Icon name="chevron-right" color={colors.onSurfaceVariant} size={14} />}
+    </Button>
+  )
+}
+
+const MusicPlaylistRow = ({ list, musicInfo, onPress }: {
+  list: LX.List.MyListInfo
+  musicInfo: LX.Music.MusicInfo
+  onPress: (list: LX.List.MyListInfo) => void
+}) => {
+  const exists = useMusicExistsList(list, musicInfo)
+  return <PlaylistRow list={list} musicInfo={musicInfo} onPress={onPress} disabled={exists} />
+}
+
+export default ({ musicInfo, excludeId, onPress }: {
+  musicInfo?: LX.Music.MusicInfo
+  excludeId?: string
+  onPress: (list: LX.List.MyListInfo) => void
+}) => {
+  const [keyword, setKeyword] = useState('')
+  const [creating, setCreating] = useState(false)
+  const colors = getMaterialColors(useTheme())
+  const lists = filterPlaylists(useMyList(), keyword, excludeId)
+  const t = useI18n()
+
+  return (
+    <View style={styles.container}>
+      <View style={{ ...styles.search, backgroundColor: colors.surfaceContainer }}>
+        <Icon name="search-2" color={colors.onSurfaceVariant} size={18} />
+        <Input value={keyword} onChangeText={setKeyword} clearBtn placeholder={t('library_search_lists')} accessibilityLabel={t('library_search_lists')} style={styles.input} />
+      </View>
+      <Button onPress={() => { setCreating(true) }} style={styles.create} accessibilityRole="button">
+        <Icon name="add_folder" color={colors.primary} size={20} />
+        <Text color={colors.primary} style={{ marginLeft: 12 }}>{t('library_create_add')}</Text>
+      </Button>
+      {creating ? <CreateUserList isEdit onHide={() => { setCreating(false) }} onCreated={onPress} /> : null}
+      <FlatList
+        style={{ flexGrow: 0, flexShrink: 1 }}
+        data={lists}
+        keyboardShouldPersistTaps="handled"
+        keyExtractor={list => list.id}
+        renderItem={({ item }) => musicInfo
+          ? <MusicPlaylistRow list={item} musicInfo={musicInfo} onPress={onPress} />
+          : <PlaylistRow list={item} onPress={onPress} disabled={false} />}
+        ListEmptyComponent={<Text style={{ padding: 20 }} color={colors.onSurfaceVariant}>{t('library_no_results')}</Text>}
+      />
+    </View>
+  )
+}
+
+const styles = createStyle({
+  container: { flexShrink: 1, paddingHorizontal: 20, paddingBottom: 20, minWidth: '90%' },
+  search: { flexDirection: 'row', alignItems: 'center', borderRadius: 28, paddingHorizontal: 16 },
+  input: { minHeight: 48, paddingLeft: 12 },
+  create: { minHeight: 56, flexDirection: 'row', alignItems: 'center', paddingHorizontal: 12 },
+  row: { minHeight: 64, flexDirection: 'row', alignItems: 'center', paddingHorizontal: 16, borderRadius: 16, marginBottom: 8 },
+})
