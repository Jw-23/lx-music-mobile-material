+  await test('creating and adding submits once, waits for persistence, and does not submit on blur', async() => {
+    const scheduler = hooks(); const wait = deferred(); let creates = 0; let hidden = 0; let created
+    const Form = load('src/components/MusicAddModal/CreateUserList.tsx', formMocks(scheduler, async(position, lists) => { creates++; assert.equal(lists[0].name, '夜晚'); await wait.promise })).default
+    const props = { isEdit: true, onHide: () => hidden++, onCreated: list => { created = list } }
