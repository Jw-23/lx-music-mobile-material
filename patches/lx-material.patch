@@ -0,0 +1,46 @@
+import { memo, useRef, useState } from 'react'
+import Button from '@/components/common/Button'
+import { Icon } from '@/components/common/Icon'
+import { toggleFavorite } from '@/core/favorites'
+import { useMusicExistsList } from '@/store/list/hook'
+import listState from '@/store/list/state'
+import { useTheme } from '@/store/theme/hook'
+import { getMaterialColors } from '@/theme/material'
+import { useI18n } from '@/lang'
+import { toast } from '@/utils/tools'
+
+export default memo(({ musicInfo }: { musicInfo: LX.Music.MusicInfo }) => {
+  const colors = getMaterialColors(useTheme())
+  const saved = useMusicExistsList(listState.loveList, musicInfo)
+  const [busy, setBusy] = useState(false)
+  const pendingRef = useRef(false)
+  const t = useI18n()
+
+  const handlePress = async() => {
+    if (pendingRef.current) return
+    pendingRef.current = true
+    setBusy(true)
+    try {
+      const added = await toggleFavorite(musicInfo)
+      toast(t(added ? 'collect_success' : 'library_favorite_removed'))
+    } catch {
+      toast(t('library_save_failed'))
+    } finally {
+      pendingRef.current = false
+      setBusy(false)
+    }
+  }
+
+  return (
+    <Button
+      onPress={handlePress}
+      disabled={busy}
+      accessibilityRole="button"
+      accessibilityLabel={t(saved ? 'library_unfavorite' : 'collect') + ' · ' + musicInfo.name}
+      accessibilityState={{ selected: saved, disabled: busy, busy }}
+      style={{ width: 48, height: 48, borderRadius: 24, alignItems: 'center', justifyContent: 'center', backgroundColor: saved ? colors.container : 'transparent' }}
+    >
+      <Icon name="love" size={20} color={saved ? colors.onContainer : colors.onSurfaceVariant} />
+    </Button>
+  )
+})
